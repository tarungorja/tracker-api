# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Same cluster the Next.js app uses.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
# Required when the URI has no /dbname (Mongoose then silently uses `test`; set this to match
# whichever database the Next.js app really reads and writes).
MONGODB_DB=
# Create/verify collection indexes on startup (idempotent; matches the Mongoose indexes).
ENSURE_INDEXES_ON_STARTUP=true

# SECRET - must equal the Next.js AUTH_SECRET so existing OTP/session hashes stay valid.
AUTH_SECRET=

# Sessions / cookies
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=30
# Use "none" (requires HTTPS) when the UI and API are on different sites.
COOKIE_SAMESITE=lax
# Defaults to true in production, false otherwise.
COOKIE_SECURE=

# Comma-separated list of UI origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# OTP emails (Brevo HTTPS API)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Hair Health Tracker

# Web push (FCM HTTP v1). Whole service-account JSON on one line (or its base64).
FIREBASE_SERVICE_ACCOUNT=

# Shared secret the external scheduler sends as "Authorization: Bearer <value>".
CRON_SECRET=

# Sends due dose reminders from inside the API every REMINDER_INTERVAL_SECONDS. Set to false when
# an external scheduler calls /api/v1/cron/send-reminders instead (e.g. serverless hosting).
REMINDER_TIMER_ENABLED=true
REMINDER_INTERVAL_SECONDS=60

# Trust the OS certificate store for outbound HTTPS to Brevo/Firebase (corporate networks that
# intercept HTTPS). Applied per HTTP client only; MongoDB TLS is unaffected.
USE_SYSTEM_CA=false
